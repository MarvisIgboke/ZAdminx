APP_NAME="Z Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_MAINTENANCE_DRIVER=file

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zadmin
DB_USERNAME=root
DB_PASSWORD=

# Session / cache / queue -----------------------------------------------------
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

# ZVend integration ------------------------------------------------------------
# Production credentials must NEVER live in source control.
ZVEND_BASE_URL=https://api.zvend.example.com
ZVEND_API_TOKEN=
ZVEND_TIMEOUT=20
ZVEND_RETRY_COUNT=3

# Runtime overrides for the values above can be stored (encrypted) in the
# api_settings table and managed by the IT Manager under API Configuration.

# Field rules (defaults; editable under System Settings at runtime) -----------
ZADMIN_MAX_GPS_ACCURACY_M=50
ZADMIN_INSPECTION_DURATIONS="60,120,180,300"

# Sanctum ----------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000
SESSION_DOMAIN=localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug
